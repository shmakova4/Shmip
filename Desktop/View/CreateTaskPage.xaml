<Page x:Class="Desktop.View.CreateTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Desktop.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Создание задачи" 
      Height="450" 
      Width="800"
      MinHeight="450" 
      MinWidth="800"
      MaxHeight="450" 
      MaxWidth="800"
      Background="#F0F0F0">

    <Grid>
        
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        
        
            <StackPanel Grid.Column="0" Margin="40,0,40,0" Height="385">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Название" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"
                   FontSize="14"/>
                <Border CornerRadius="8"
                Background="White"
                Margin="0,0,0,20">
                    <TextBox Name="TitleTextBox" 
                     BorderThickness="0"
                     Padding="10"
                     Height="41"
                     FontSize="14"
                     Background="Transparent"/>
                </Border>
                

                <TextBlock Text="Категория" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"
                   FontSize="14"/>
                <Border CornerRadius="8"
                Background="White"
                Margin="0,0,0,20">
                    <ComboBox Name="CategoryComboBox" 
                      BorderThickness="0"
                      Padding="10"
                      Height="51"
                      FontSize="14"
                      Background="Transparent">
                        <ComboBoxItem>Дом</ComboBoxItem>
                        <ComboBoxItem>Работа</ComboBoxItem>
                        <ComboBoxItem>Учеба</ComboBoxItem>
                        <ComboBoxItem>Отдых</ComboBoxItem>
                    </ComboBox>
                </Border>

                <TextBlock Text="Описание" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"
                   FontSize="14"/>
                <Border CornerRadius="8"
                Background="White"
                Margin="0,0,0,30">
                    <TextBox Name="DescriptionTextBox" 
                     BorderThickness="0"
                     Padding="10"
                     Height="89"
                     FontSize="14"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
                </Border>

                <Button x:Name="CreateButton" 
                Content="Создать" 
                Width="150"
                Height="40"
                Background="#4CAF50"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Click="CreateButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" 
            Width="1" 
            Background="#CCCCCC"
            Margin="0,40"/>

            <Grid Grid.Column="2" Margin="40,-14,40,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Дата" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"
                       FontSize="14" Height="20"/>
                    <Border CornerRadius="8"
                    Background="White"
                    Margin="0,0,0,30">
                        <DatePicker Name="DatePickerControl"
                          BorderThickness="0"
                          Padding="10"
                          Height="42"
                          FontSize="14"
                          Background="Transparent">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </Border>

                    <TextBlock Text="Время" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"
                       FontSize="14"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                        CornerRadius="8"
                        Background="White">
                            <ComboBox Name="HoursComboBox"
                            BorderThickness="0"
                            Padding="10"
                            Height="35"
                            FontSize="14"
                            Background="Transparent">
                                <ComboBoxItem>08</ComboBoxItem>
                                <ComboBoxItem>09</ComboBoxItem>
                                <ComboBoxItem>10</ComboBoxItem>
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>15</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>17</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                                <ComboBoxItem>19</ComboBoxItem>
                                <ComboBoxItem>20</ComboBoxItem>
                            </ComboBox>
                        </Border>

                        <TextBlock Grid.Column="1" 
                           Text=":" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"/>

                        <Border Grid.Column="2" 
                        CornerRadius="8"
                        Background="White">
                            <ComboBox Name="MinutesComboBox"
                            BorderThickness="0"
                            Padding="10"
                            Height="35"
                            FontSize="14"
                            Background="Transparent">
                                <ComboBoxItem>00</ComboBoxItem>
                                <ComboBoxItem>15</ComboBoxItem>
                                <ComboBoxItem>30</ComboBoxItem>
                                <ComboBoxItem>45</ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </Grid>
                </StackPanel>

                <Button Name="CancelButton" 
                Content="Отмена" 
                Width="150"
                Height="40"
                Background="#F44336"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Click="CancelButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,366,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

    </Grid>
</Page>
