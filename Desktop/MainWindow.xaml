<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Log In" Height="450" Width="800">
    <Grid>
        <Label Content="Добро пожаловать!" HorizontalAlignment="Left" Margin="414,37,0,0" VerticalAlignment="Top" Width="262" FontSize="27"/>
        <Label Content="Почта" HorizontalAlignment="Left" Margin="414,120,0,0" VerticalAlignment="Top" Width="112" FontSize="22"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="414,212,0,0" VerticalAlignment="Top" Width="94" FontSize="22" Height="44"/>
        <TextBox Height="30" FontSize="16" Padding="0,0,0,5" Foreground="Gray" Margin="414,164,54,240" Text="Введите почту" TextChanged="TextBox_TextChanged_2">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBox Height="30" FontSize="16" Padding="0,0,0,5" Foreground="Gray" Margin="414,256,54,148" Text="Введите пароль">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Button Content="Восстановить пароль" HorizontalAlignment="Left" Margin="533,291,0,0" VerticalAlignment="Top" Width="213" Background="White" BorderThickness="0,0,0,0" FontSize="20"/>
        <Button Content="Войти" HorizontalAlignment="Left" Margin="414,337,0,0" VerticalAlignment="Top" Background="#FFF26B6B" BorderThickness="0,0,0,0" Foreground="White" Height="32" Width="332" FontSize="16"/>
        <Button Content="Регистрация" HorizontalAlignment="Left" Margin="414,383,0,0" VerticalAlignment="Top" Background="#FFF26B6B" BorderThickness="0,0,0,0" Foreground="White" Height="32" Width="332" FontSize="16"/>
        <Image Source="file:///C:/Users/User/Desktop/2%20курс/Todo/images/logo.jpg" Margin="64,22,546,255"/>


    </Grid>

</Window>
