<Window x:Class="Desktop.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid>
        <Label Content="Welkome back" HorizontalAlignment="Left" Margin="414,10,0,0" VerticalAlignment="Top" Width="262" FontSize="27"/>
        <Label Content="Имя пользователя" Margin="414,69,0,0" VerticalAlignment="Top" Width="201" FontSize="18" Height="35" HorizontalAlignment="Left"/>
        <Label Content="Ваша почта" HorizontalAlignment="Left" Margin="414,131,0,0" VerticalAlignment="Top" Width="140" FontSize="18" Height="40"/>
        <TextBox FontSize="14" Padding="0,0,0,5" Foreground="Gray" Margin="414,101,80,306" Text="Введите имя пользователя" TextChanged="TextBox_TextChanged_2">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBox FontSize="14" Padding="0,0,0,5" Foreground="Gray" Margin="414,161,80,246" Text="exam@yandex.ru">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="414,337,0,0" VerticalAlignment="Top" Background="#FFF26B6B" BorderThickness="0,0,0,0" Foreground="White" Height="32" Width="306" FontSize="16"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="414,383,0,0" VerticalAlignment="Top" Background="#FFF26B6B" BorderThickness="0,0,0,0" Foreground="White" Height="32" Width="306" FontSize="16"/>
        <Image Source="file:///C:/Users/User/Desktop/2%20курс/Todo/images/logo.jpg" Margin="64,22,546,255"/>
        <Label Content="Повторите пароль" HorizontalAlignment="Left" Margin="414,247,0,0" VerticalAlignment="Top" Width="175" FontSize="18" Height="35"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="414,187,0,0" VerticalAlignment="Top" Width="87" FontSize="18" Height="39"/>
        <TextBox FontSize="14" Padding="0,0,0,5" Foreground="Gray" Margin="414,278,80,129" Text="Повторите пароль" TextChanged="TextBox_TextChanged_2">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBox FontSize="14" Padding="0,0,0,5" Foreground="Gray" Margin="414,217,80,190" Text="Введите пароль">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

    </Grid>
</Window>
