<Window x:Class="Desktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="История выполненных задач" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" 
                      Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Name="HistoryStackPanel">
                
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" 
                Background="White" 
                BorderThickness="1,0,0,0"
                BorderBrush="#333333">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" 
                              Padding="30"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Name="HistoryTaskTitle" 
                                   Text="Выберите задачу" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <TextBlock Name="HistoryTaskTime" 
                                   Text="" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Name="HistoryTaskDate" 
                                   Text="" 
                                   FontSize="14"
                                   Foreground="#666666"
                                   Margin="0,0,0,30"/>

                        <TextBlock Name="HistoryTaskDescription" 
                                   Text=""
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Foreground="#333333"
                                   TextAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" 
                        Background="#F8F8F8" 
                        Padding="30,20">
                    <TextBlock Text="Выполненные задачи"
                               FontSize="14"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>